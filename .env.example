# HTTP port this service listens on
PORT=4000

# Redis — same instance as saleor_platform, but DB index 2.
# Saleor uses db 0 (CACHE_URL) and db 1 (CELERY_BROKER_URL); db 2 avoids key collisions.
# In Docker (shared network) this becomes: redis://redis:6379/2
REDIS_URL=redis://localhost:6379/2

# Postgres — same instance/credentials as saleor_platform/backend.env.
# In Docker (shared network) this becomes: postgres://saleor:saleor@db:5432/saleor
DATABASE_URL=postgres://saleor:saleor@localhost:5432/saleor
