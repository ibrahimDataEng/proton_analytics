{
	"name": "proton-analytics",
	"version": "1.0.0",
	"private": true,
	"description": "Product view tracking and trending score service",
	"main": "dist/server.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/server.js",
		"dev": "tsx watch src/server.ts",
		"aggregate:once": "tsx src/scripts/runAggregationOnce.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"ioredis": "^5.4.2",
		"node-cron": "^3.0.3",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/node": "^22.10.5",
		"@types/node-cron": "^3.0.11",
		"@types/pg": "^8.11.10",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": ">=20"
	}
}
